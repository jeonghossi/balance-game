{
  "rules": {
    ".read": false,
    ".write": false,
    "votes": {
      ".read": true,
      "$q": {
        "$side": {
          ".write": "$q.matches(/^q[0-9]{2,4}$/) && ($side === 'a' || $side === 'b')",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    }
  }
}
